# /etc/skiwi/skiwi.env （各ノードで NODE_ID / NODE_URL だけ変える。権限 0600, 所有者 skiwi）
DATABASE_URL=jdbc:postgresql://10.0.0.11:5432,10.0.0.12:5432,10.0.0.13:5432/skiwi?targetServerType=primary&connectTimeout=3&tcpKeepAlive=true
DATABASE_USER=skiwi
DATABASE_PASSWORD=change-me
OIDC_ISSUER=https://auth.example.com/application/o/skiwi/
OIDC_CLIENT_ID=change-me
OIDC_CLIENT_SECRET=change-me
PUBLIC_URL=https://skiwi.example.com
ADMIN_GROUPS=skiwi-admins
STATIC_DIR=/opt/skiwi/current/static
HTTP_PORT=8080
# 3ノード構成
NODE_ID=skiwi1
NODE_URL=http://10.0.0.11:8080
CLUSTER_SECRET=change-me-32-random-chars-same-on-all-nodes
# 添付（S3 互換ストレージ。各VMで動かす場合は VIP 経由の HAProxy で3台に分散）
S3_ENDPOINT=http://10.0.0.10:7480
S3_BUCKET=skiwi
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
MAX_UPLOAD_MB=100
# メール（SMTPサーバー）
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=skiwi@example.com
SMTP_PASSWORD=change-me
MAIL_FROM=skiwi@example.com
# SCIM（IdP のSCIMプロビジョニングに設定するトークンと同じ値）
SCIM_TOKEN=change-me-long-random
# 秘密の値（16文字以上。例: openssl rand -base64 32）。外部サービス（skea・skawau・smohua 連携）のトークンなどの暗号化に使う。全ノードで同じ値にする。
# 変えると保存済みの連携（各ユーザーのトークン・client_secret）は読めなくなるので、設定し直しが必要。
APP_SECRET=change-me
