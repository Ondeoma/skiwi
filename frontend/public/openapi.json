{
 "openapi": "3.0.3",
 "info": {
  "title": "skiwi API",
  "version": "1.0",
  "description": "skiwi の REST API。認証は `Authorization: Bearer <APIトークン>`（サイドバー下部の「APIトークン」で発行）か、ログイン中のブラウザのCookie。\n\n- 権限のないページ・ワークスペースは、存在を隠すため 404 を返す。閲覧はできるが編集できない場合は 403。\n- 読み取り専用のトークンでは、書き込み（POST・PUT・PATCH・DELETE）は 403。\n- 時刻は ISO 8601（UTC）。エラーは `{ \"error\": \"…\" }`。"
 },
 "servers": [
  {
   "url": "/"
  }
 ],
 "components": {
  "securitySchemes": {
   "bearer": {
    "type": "http",
    "scheme": "bearer",
    "description": "APIトークン"
   },
   "cookie": {
    "type": "apiKey",
    "in": "cookie",
    "name": "skiwi_session"
   }
  },
  "schemas": {
   "Error": {
    "type": "object",
    "properties": {
     "error": {
      "type": "string"
     }
    }
   },
   "Page": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "format": "uuid"
     },
     "workspaceId": {
      "type": "string",
      "format": "uuid"
     },
     "parentId": {
      "type": "string",
      "format": "uuid",
      "nullable": true
     },
     "position": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "icon": {
      "type": "string",
      "nullable": true
     },
     "role": {
      "type": "string",
      "enum": [
       "view",
       "edit"
      ]
     },
     "updatedAt": {
      "type": "string",
      "format": "date-time"
     },
     "published": {
      "type": "boolean"
     },
     "labels": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "ownerId": {
      "type": "string",
      "format": "uuid",
      "nullable": true
     },
     "ownerName": {
      "type": "string",
      "nullable": true
     },
     "status": {
      "type": "string",
      "enum": [
       "draft",
       "review",
       "published",
       "deprecated"
      ],
      "nullable": true
     },
     "database": {
      "type": "boolean"
     },
     "locked": {
      "type": "boolean"
     }
    }
   },
   "Workspace": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "format": "uuid"
     },
     "name": {
      "type": "string"
     },
     "role": {
      "type": "string",
      "enum": [
       "view",
       "edit"
      ]
     },
     "favorite": {
      "type": "boolean"
     }
    }
   },
   "Content": {
    "type": "object",
    "properties": {
     "content": {
      "type": "object",
      "description": "本文（Tiptap / ProseMirror の JSON）"
     },
     "text": {
      "type": "string",
      "description": "平文"
     },
     "updatedAt": {
      "type": "string",
      "format": "date-time"
     }
    }
   },
   "Version": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "format": "uuid"
     },
     "createdAt": {
      "type": "string",
      "format": "date-time"
     },
     "label": {
      "type": "string",
      "nullable": true
     },
     "createdBy": {
      "type": "string",
      "nullable": true
     },
     "authors": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   },
   "SearchResult": {
    "type": "object",
    "properties": {
     "page": {
      "$ref": "#/components/schemas/Page"
     },
     "snippet": {
      "type": "string",
      "nullable": true,
      "description": "一致箇所を含む抜粋（HTML。キーワードのみ装飾）"
     },
     "fuzzy": {
      "type": "boolean"
     }
    }
   },
   "Comment": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "format": "uuid"
     },
     "threadId": {
      "type": "string",
      "format": "uuid",
      "nullable": true
     },
     "anchor": {
      "type": "string",
      "nullable": true
     },
     "quote": {
      "type": "string",
      "nullable": true
     },
     "body": {
      "type": "string"
     },
     "authorId": {
      "type": "string",
      "format": "uuid",
      "nullable": true
     },
     "authorName": {
      "type": "string",
      "nullable": true
     },
     "createdAt": {
      "type": "string",
      "format": "date-time"
     },
     "updatedAt": {
      "type": "string",
      "format": "date-time"
     },
     "resolvedAt": {
      "type": "string",
      "format": "date-time",
      "nullable": true
     }
    }
   },
   "AclEntry": {
    "type": "object",
    "properties": {
     "principalType": {
      "type": "string",
      "enum": [
       "user",
       "group"
      ]
     },
     "principalId": {
      "type": "string",
      "format": "uuid"
     },
     "role": {
      "type": "string",
      "enum": [
       "view",
       "edit"
      ]
     },
     "expiresAt": {
      "type": "string",
      "format": "date-time",
      "nullable": true,
      "description": "権限の期限（過ぎると自動で外れる）"
     }
    }
   },
   "Task": {
    "type": "object",
    "properties": {
     "pageId": {
      "type": "string",
      "format": "uuid"
     },
     "workspaceId": {
      "type": "string",
      "format": "uuid"
     },
     "workspaceName": {
      "type": "string"
     },
     "pageTitle": {
      "type": "string"
     },
     "seq": {
      "type": "integer"
     },
     "text": {
      "type": "string"
     },
     "checked": {
      "type": "boolean"
     },
     "due": {
      "type": "string",
      "format": "date",
      "nullable": true
     }
    }
   },
   "DbProp": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "type": {
      "type": "string",
      "enum": [
       "text",
       "number",
       "select",
       "multi_select",
       "date",
       "person",
       "checkbox",
       "url",
       "relation",
       "rollup"
      ]
     },
     "options": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "id": {
         "type": "string"
        },
        "name": {
         "type": "string"
        },
        "color": {
         "type": "string"
        }
       }
      }
     },
     "target": {
      "type": "string",
      "format": "uuid",
      "description": "relation: 関連先のデータベース"
     },
     "relation": {
      "type": "string",
      "description": "rollup: 関連の列のID"
     },
     "fn": {
      "type": "string",
      "enum": [
       "count",
       "count_values",
       "sum",
       "avg",
       "min",
       "max",
       "checked"
      ]
     },
     "prop": {
      "type": "string",
      "description": "rollup: 関連先の列のID"
     }
    }
   },
   "Database": {
    "type": "object",
    "properties": {
     "pageId": {
      "type": "string",
      "format": "uuid"
     },
     "props": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/DbProp"
      }
     },
     "views": {
      "type": "array",
      "items": {
       "type": "object"
      }
     },
     "rows": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "page": {
         "$ref": "#/components/schemas/Page"
        },
        "values": {
         "type": "object",
         "description": "列のID → 値"
        }
       }
      }
     },
     "users": {
      "type": "object",
      "additionalProperties": {
       "type": "string"
      }
     },
     "canEdit": {
      "type": "boolean"
     }
    }
   },
   "Attachment": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "format": "uuid"
     },
     "url": {
      "type": "string"
     },
     "filename": {
      "type": "string"
     },
     "contentType": {
      "type": "string"
     },
     "size": {
      "type": "integer"
     }
    }
   },
   "BulkResult": {
    "type": "object",
    "properties": {
     "done": {
      "type": "array",
      "items": {
       "type": "string",
       "format": "uuid"
      }
     },
     "skipped": {
      "type": "array",
      "items": {
       "type": "string",
       "format": "uuid"
      }
     },
     "failed": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "id": {
         "type": "string",
         "format": "uuid"
        },
        "title": {
         "type": "string",
         "nullable": true
        },
        "error": {
         "type": "string"
        }
       }
      }
     }
    }
   }
  }
 },
 "security": [
  {
   "bearer": []
  },
  {
   "cookie": []
  }
 ],
 "tags": [
  {
   "name": "ユーザー"
  },
  {
   "name": "ワークスペース"
  },
  {
   "name": "ページ"
  },
  {
   "name": "権限"
  },
  {
   "name": "検索"
  },
  {
   "name": "コメント"
  },
  {
   "name": "添付"
  },
  {
   "name": "ToDo"
  },
  {
   "name": "データベース"
  },
  {
   "name": "点検"
  },
  {
   "name": "連携"
  },
  {
   "name": "APIトークン"
  }
 ],
 "paths": {
  "/api/me": {
   "get": {
    "tags": [
     "ユーザー"
    ],
    "summary": "自分の情報",
    "parameters": [],
    "responses": {
     "200": {
      "description": "成功",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "id": {
           "type": "string",
           "format": "uuid"
          },
          "name": {
           "type": "string"
          },
          "email": {
           "type": "string",
           "nullable": true
          },
          "groups": {
           "type": "array",
           "items": {
            "type": "string"
           }
          },
          "isAdmin": {
           "type": "boolean"
          }
         }
        }
       }
      }
     },
     "401": {
      "description": "未認証"
     },
     "403": {
      "description": "権限がない（閲覧のみ・読み取り専用トークンでの書き込み）"
     },
     "404": {
      "description": "見つからない（閲覧権限がない場合も404）"
     }
    }
   }
  },
  "/api/directory": {
   "get": {
    "tags": [
     "ユーザー"
    ],
    "summary": "ユーザー・グループの検索",
    "parameters": [
     {
      "name": "q",
      "in": "query",
      "required": true,
      "description": "名前・メール（ひらがな/カタカナ・全角/半角の違いは無視）",
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "成功",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "type": "object",
          "properties": {
           "principalType": {
            "type": "string"
           },
           "id": {
            "type": "string",
            "format": "uuid"
           },
           "name": {
            "type": "string"
           },
           "detail": {
            "type": "string",
            "nullable": true
           }
          }
         }
        }
       }
      }
     },
     "401": {
      "description": "未認証"
     },
     "403": {
      "description": "権限がない（閲覧のみ・読み取り専用トークンでの書き込み）"
     },
     "404": {
      "description": "見つからない（閲覧権限がない場合も404）"
     }
    }
   }
  },
  "/api/workspaces": {
   "get": {
    "tags": [
     "ワークスペース"
    ],
    "summary": "見られるワークスペースの一覧",
    "parameters": [],
    "responses": {
     "200": {
      "description": "成功",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/Workspace"
         }
        }
       }
      }
     },
     "401": {
      "description": "未認証"
     },
     "403": {
      "description": "権限がない（閲覧のみ・読み取り専用トークンでの書き込み）"
     },
     "404": {
      "description": "見つからない（閲覧権限がない場合も404）"
     }
    }
   },
   "post": {
    "tags": [
     "ワークスペース"
    ],
    "summary": "ワークスペースを作る",
    "parameters": [],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "name": {
          "type": "string"
         }
        }
       }
      }
     }
    },
    "responses": {
     "201": {
      "description": "成功",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Workspace"
        }
       }
      }
     },
     "401": {
      "description": "未認証"
     },
     "403": {
      "description": "権限がない（閲覧のみ・読み取り専用トークンでの書き込み）"
     },
     "404": {
      "description": "見つからない（閲覧権限がない場合も404）"
     }
    }
   }
  },
  "/api/workspaces/{wsId}/pages": {
   "get": {
    "tags": [
     "ページ"
    ],
    "summary": "ワークスペースのページ一覧（閲覧できるもの）",
    "parameters": [
     {
      "name": "wsId",
      "in": "path",
      "required": true,
      "description": "ワークスペースID",
      "schema": {
       "type": "string",
       "format": "uuid"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "成功",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/Page"
         }
        }
       }
      }
     },
     "401": {
      "description": "未認証"
     },
     "403": {
      "description": "権限がない（閲覧のみ・読み取り専用トークンでの書き込み）"
     },
     "404": {
      "description": "見つからない（閲覧権限がない場合も404）"
     }
    }
   },
   "post": {
    "tags": [
     "ページ"
    ],
    "summary": "ページを作る",
    "parameters": [
     {
      "name": "wsId",
      "in": "path",
      "required": true,
      "description": "ワークスペースID",
      "schema": {
       "type": "string",
       "format": "uuid"
      }
     }
    ],
    "description": "本文は、作ったあとに POST /api/pages/{id}/content（Markdown）で入れる。",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "title": {
          "type": "string"
         },
         "parentId": {
          "type": "string",
          "format": "uuid",
          "nullable": true
         },
         "afterId": {
          "type": "string",
          "format": "uuid"
         },
         "placement": {
          "type": "string",
          "enum": [
           "first",
           "last"
          ]
         },
         "icon": {
          "type": "string"
         }
        }
       }
      }
     }
    },
    "responses": {
     "201": {
      "description": "成功",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Page"
        }
       }
      }
     },
     "401": {
      "description": "未認証"
     },
     "403": {
      "description": "権限がない（閲覧のみ・読み取り専用トークンでの書き込み）"
     },
     "404": {
      "description": "見つからない（閲覧権限がない場合も404）"
     }
    }
   }
  },
  "/api/pages/{id}": {
   "get": {
    "tags": [
     "ページ"
    ],
    "summary": "ページの情報",
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "description": "ページID",
      "schema": {
       "type": "string",
       "format": "uuid"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "成功",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Page"
        }
       }
      }
     },
     "401": {
      "description": "未認証"
     },
     "403": {
      "description": "権限がない（閲覧のみ・読み取り専用トークンでの書き込み）"
     },
     "404": {
      "description": "見つからない（閲覧権限がない場合も404）"
     }
    }
   },
   "patch": {
    "tags": [
     "ページ"
    ],
    "summary": "タイトル・アイコン・所有者・状態を変える",
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "description": "ページID",
      "schema": {
       "type": "string",
       "format": "uuid"
      }
     }
    ],
    "description": "項目を省くと変えない。null で外す。",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "title": {
          "type": "string"
         },
         "icon": {
          "type": "string",
          "nullable": true
         },
         "ownerId": {
          "type": "string",
          "format": "uuid",
          "nullable": true
         },
         "status": {
          "type": "string",
          "nullable": true
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "成功",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Page"
        }
       }
      }
     },
     "401": {
      "description": "未認証"
     },
     "403": {
      "description": "権限がない（閲覧のみ・読み取り専用トークンでの書き込み）"
     },
     "404": {
      "description": "見つからない（閲覧権限がない場合も404）"
     }
    }
   },
   "delete": {
    "tags": [
     "ページ"
    ],
    "summary": "ゴミ箱へ移す（子ページも）",
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "description": "ページID",
      "schema": {
       "type": "string",
       "format": "uuid"
      }
     }
    ],
    "responses": {
     "204": {
      "description": "成功"
     },
     "401": {
      "description": "未認証"
     },
     "403": {
      "description": "権限がない（閲覧のみ・読み取り専用トークンでの書き込み）"
     },
     "404": {
      "description": "見つからない（閲覧権限がない場合も404）"
     }
    }
   }
  },
  "/api/pages/{id}/move": {
   "post": {
    "tags": [
     "ページ"
    ],
    "summary": "移動する（並べ替え・親の変更・別のワークスペースへ）",
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "description": "ページID",
      "schema": {
       "type": "string",
       "format": "uuid"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "parentId": {
          "type": "string",
          "format": "uuid",
          "nullable": true
         },
         "afterId": {
          "type": "string",
          "format": "uuid"
         },
         "placement": {
          "type": "string"
         },
         "workspaceId": {
          "type": "string",
          "format": "uuid"
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "成功",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Page"
        }
       }
      }
     },
     "401": {
      "description": "未認証"
     },
     "403": {
      "description": "権限がない（閲覧のみ・読み取り専用トークンでの書き込み）"
     },
     "404": {
      "description": "見つからない（閲覧権限がない場合も404）"
     }
    }
